
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")

}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id    Int    @id @default(autoincrement())
  email  String  @unique
  name   String
  role   Role  @default(PATRON)
}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String  @unique
  books  Book[]
}

model Book {
  id      Int     @id @default(autoincrement())
  title   String
  author  String
  isbn    String?
  genreId  Int 
  genre   Genre   @relation(fields: [genreId], references: [id])
}